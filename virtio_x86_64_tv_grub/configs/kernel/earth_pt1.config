# Earthsoft PT1/PT2 DVB stack.
# Keep the PT1 driver and the frontend/tuner drivers it probes built in because
# Android disables the kernel's normal module autoload helper during early init.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_I2C=y
CONFIG_DVB_CORE=y
CONFIG_DVB_PT1=y
CONFIG_DVB_TC90522=y
CONFIG_DVB_PLL=y
CONFIG_MEDIA_TUNER_QM1D1B0004=y
